generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CLIENT
  STAFF
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  role         Role          @default(CLIENT)
  password     String        @default("password")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  accounts     Account[]
  sessions     Session[]
  reservations Reservation[]
}

model Table {
  name         String        @default("mesa-")
  id           String        @id @default(cuid())
  capacity     Int
  active       Boolean       @default(true)
  reservations Reservation[]
  deletedAt    DateTime?
}

model Reservation {
  id           String    @id @default(cuid())
  userId       String
  tableId      String
  date         String    // YYYY-MM-DD
  startHour    Int
  endHour      Int
  status       Status    @default(PENDING)
  customerName String
  occupants    Int       @default(1)
  notes        String?
  user         User      @relation(fields: [userId], references: [id])
  table        Table     @relation(fields: [tableId], references: [id])
  deletedAt    DateTime?
}

model SystemConfig {
  id                    String @id @default("config")
  cancellationWindow    Int    @default(24) // horas
  notificationRetention Int    @default(30) // días
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
